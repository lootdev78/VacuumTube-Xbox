{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VacuumTube: Bundle bauen",
      "type": "process",
      "command": "python",
      "args": ["tools/build_bundle.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "VacuumTube: Projekt validieren",
      "type": "process",
      "command": "python",
      "args": ["tools/validate_project.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "VacuumTube: JS-Bundle und Validierung",
      "dependsOrder": "sequence",
      "dependsOn": [
        "VacuumTube: Bundle bauen",
        "VacuumTube: Projekt validieren"
      ],
      "problemMatcher": []
    },
    {
      "label": "VacuumTube: UWP Release bauen",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\tools\\Build-Xbox.ps1",
        "-Configuration", "Release",
        "-Platform", "x64"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$msCompile"
    },
    {
      "label": "VacuumTube: signiertes Xbox-Sideload-Paket",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\tools\\Build-Xbox.ps1",
        "-Configuration", "Release",
        "-Platform", "x64",
        "-Package",
        "-GenerateTestCertificate"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$msCompile"
    }
  ]
}
